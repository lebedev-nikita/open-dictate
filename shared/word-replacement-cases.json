[
  {"name":"case and boundaries","rules":[{"source":"cat","replacement":"Kitten"}],"text":"CAT, cat! catalog bobcat cat2 cat_name.","expected":"Kitten, Kitten! catalog bobcat cat2 cat_name."},
  {"name":"Cyrillic and emoji","rules":[{"source":"опен диктейт","replacement":"OpenDictate"}],"text":"🙂 ОПЕН ДИКТЕЙТ и опен диктейт.","expected":"🙂 OpenDictate и OpenDictate."},
  {"name":"longest phrase first","rules":[{"source":"new","replacement":"fresh"},{"source":"new york","replacement":"NYC"}],"text":"New York, new day.","expected":"NYC, fresh day."},
  {"name":"no cascading","rules":[{"source":"alpha","replacement":"beta"},{"source":"beta","replacement":"gamma"}],"text":"alpha beta","expected":"beta gamma"},
  {"name":"literal symbols and replacement","rules":[{"source":"c++","replacement":"C++ $1 \\ tools"}],"text":"c++ and c++17","expected":"C++ $1 \\ tools and c++17"},
  {"name":"disabled","rules":[{"source":"cat","replacement":"dog","enabled":false}],"text":"Cat cat","expected":"Cat cat"},
  {"name":"canonical Unicode","rules":[{"source":"café","replacement":"Coffee"}],"text":"café CAFÉ.","expected":"Coffee Coffee."},
  {"name":"combining mark is word content","rules":[{"source":"cat","replacement":"dog"}],"text":"cat́ cat.","expected":"cat́ dog."},
  {"name":"live trailing token","rules":[{"source":"cat","replacement":"dog"}],"text":"cat cat","final":false,"expected":"dog cat"},
  {"name":"live growing token","rules":[{"source":"cat","replacement":"dog"}],"text":"catalog","final":false,"expected":"catalog"},
  {"name":"live delimiter","rules":[{"source":"cat","replacement":"dog"}],"text":"cat ","final":false,"expected":"dog "},
  {"name":"final token","rules":[{"source":"cat","replacement":"dog"}],"text":"cat","expected":"dog"},
  {"name":"literal dots","rules":[{"source":"a.b","replacement":"Term"}],"text":"a.b axb a.bx","expected":"Term axb a.bx"},
  {"name":"empty dictionary","rules":[],"text":"Leave this 🙂 alone","expected":"Leave this 🙂 alone"},
  {"name":"replacement multiline","rules":[{"source":"my address","replacement":"First line\nSecond line"}],"text":"my address.","expected":"First line\nSecond line."},
  {"name":"repeated cumulative text","rules":[{"source":"open dictate","replacement":"OpenDictate"}],"text":"open dictate and open dictate.","expected":"OpenDictate and OpenDictate."},
  {"name":"regex groups","rules":[{"source":"(\\d+) ?руб\\w*","replacement":"$1 ₽","regex":true}],"text":"Итого 250 рублей и 3руб.","expected":"Итого 250 ₽ и 3 ₽."},
  {"name":"regex ignores case","rules":[{"source":"open ?dictate","replacement":"OpenDictate","regex":true}],"text":"OPEN DICTATE and opendictate","expected":"OpenDictate and OpenDictate"},
  {"name":"regex has no implicit boundaries","rules":[{"source":"\\s+([,.!?])","replacement":"$1","regex":true}],"text":"Hello , world !","expected":"Hello, world!"},
  {"name":"regex explicit boundary","rules":[{"source":"\\bcat\\b","replacement":"dog","regex":true}],"text":"cat catalog","expected":"dog catalog"},
  {"name":"regex empty replacement deletes","rules":[{"source":"\\s*\\b(?:um|uh)\\b","replacement":"","regex":true}],"text":"So um I think uh yes","expected":"So I think yes"},
  {"name":"regex template escapes","rules":[{"source":"(a)(b)","replacement":"$$ ${2}$1 $x $","regex":true}],"text":"ab","expected":"$ ba $x $"},
  {"name":"regex two-digit braced group","rules":[{"source":"(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)(l)","replacement":"${12}$12","regex":true}],"text":"abcdefghijkl","expected":"la2"},
  {"name":"regex unmatched group is empty","rules":[{"source":"x(y)?","replacement":"[$1]","regex":true}],"text":"x xy","expected":"[] [y]"},
  {"name":"regex result does not cascade","rules":[{"source":"a","replacement":"b","regex":true},{"source":"b","replacement":"c"}],"text":"a b","expected":"b c"},
  {"name":"earliest match wins across kinds","rules":[{"source":"new york","replacement":"NYC"},{"source":"york city","replacement":"YC","regex":true}],"text":"new york city","expected":"NYC city"},
  {"name":"longer match wins at same start","rules":[{"source":"new","replacement":"fresh"},{"source":"new \\w+","replacement":"X","regex":true}],"text":"new day","expected":"X"},
  {"name":"literal wins equal regex match","rules":[{"source":"c.t","replacement":"regex","regex":true},{"source":"cat","replacement":"literal"}],"text":"cat cut","expected":"literal regex"},
  {"name":"invalid regex is skipped","rules":[{"source":"(","replacement":"x","regex":true},{"source":"cat","replacement":"dog"}],"text":"( cat","expected":"( dog"},
  {"name":"regex live trailing match waits","rules":[{"source":"\\d+","replacement":"#","regex":true}],"text":"call 12 34","final":false,"expected":"call # 34"},
  {"name":"regex final trailing match","rules":[{"source":"\\d+","replacement":"#","regex":true}],"text":"call 12 34","expected":"call # #"},
  {"name":"regex Unicode classes","rules":[{"source":"\\w+ий\\b","replacement":"X","regex":true}],"text":"синий СИНИЙ","expected":"X X"},
  {"name":"regex disabled","rules":[{"source":"cat","replacement":"dog","regex":true,"enabled":false}],"text":"cat","expected":"cat"},
  {"name":"match case phrase","rules":[{"source":"ИП","replacement":"предприниматель","matchCase":true}],"text":"ИП, ип и Ип.","expected":"предприниматель, ип и Ип."},
  {"name":"match case applies per phrase","rules":[{"source":"US","replacement":"United States","matchCase":true},{"source":"cat","replacement":"dog"}],"text":"US us CAT","expected":"United States us dog"},
  {"name":"match case regex inside words","rules":[{"source":"ё","replacement":"е","regex":true,"matchCase":true},{"source":"Ё","replacement":"Е","regex":true,"matchCase":true}],"text":"Ёжик всё ещё у ЁЛКИ.","expected":"Ежик все еще у ЕЛКИ."},
  {"name":"match case regex classes","rules":[{"source":"[A-Z]{2,}","replacement":"#","regex":true,"matchCase":true}],"text":"NASA nasa Nasa","expected":"# nasa Nasa"},
  {"name":"regex dashes and quotes","rules":[{"source":"\\s*[—–]\\s*","replacement":" - ","regex":true},{"source":"[«»“”„]","replacement":"\"","regex":true}],"text":"Он сказал — «да» – “нет”.","expected":"Он сказал - \"да\" - \"нет\"."}
]
